# انسخي هذا الملف باسم .env وعدّلي القيم. لا تضعي أي كلمة مرور هنا؛ حساب المديرة يُنشأ بالأمر:
#   python manage.py create-admin

# العنوان والمنفذ الذي يستمع عليه الخادم (خلف nginx اتركيه 127.0.0.1)
ZUM_HOST=127.0.0.1
ZUM_PORT=8000

# مسار قاعدة البيانات ومجلد الصور المرفوعة (الافتراضي: data/zumurrud.db و uploads/)
# ZUM_DB=/srv/zumurrud/data/zumurrud.db
# ZUM_UPLOADS=/srv/zumurrud/uploads

# كوكي الجلسة يُرسل عبر HTTPS فقط (1). للتجربة المحلية على http فقط ضعي 0
ZUM_COOKIE_SECURE=1

# عدد الخوادم العكسية الموثوقة أمام التطبيق (nginx = 1). اتركيه 0 إن لم يوجد
ZUM_PROXY_HOPS=0

# مدة الخمول قبل انتهاء الجلسة (ثوانٍ) والحد الأقصى للجلسة
ZUM_SESSION_IDLE=1800
ZUM_SESSION_MAX=28800

# نسخة احتياطية تلقائية عند الحفظ إن مضى على آخر نسخة أكثر من (ثوانٍ)
ZUM_BACKUP_INTERVAL=21600
