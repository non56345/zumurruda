# ==============================================================================
# إعدادات موقع الزُمردة (MongoDB Atlas + Vercel)
# ==============================================================================

# رابط الاتصال بقاعدة بيانات MongoDB Atlas (مطلوب)
# احصلي عليه من MongoDB Atlas -> Connect -> Drivers -> Python
# تأكدي من استبدال USER و PASS باسم المستخدم وكلمة المرور
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# اسم قاعدة البيانات في Atlas (الافتراضي: zumurruda)
MONGODB_DB=zumurruda

# المفتاح السري لتشفير الجلسات وحماية التطبيق (مطلوب في الإنتاج، 64+ حرفاً عشوائياً)
# يمكن توليده محلياً عبر: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# رمز الإعداد الأولي لحساب المديرة (مطلوب لفتح صفحة /admin/setup لمرة واحدة، 24+ حرفاً)
# بعد إنشاء حسابكِ من المتصفح يُنصح بحذف هذا المتغير لتقليل سطح الهجوم
SETUP_TOKEN=

# تشغيل كوكيز الجلسات بنمط آمن عبر HTTPS فقط (1 للإنتاج، 0 للتطوير المحلي على http)
ZUM_COOKIE_SECURE=1

# عدد الوكلاء الموثوقين لقراءة عنوان IP الحقيقي للزائر (1 لبيئة Vercel)
ZUM_PROXY_HOPS=1

# التجهيز التلقائي لقاعدة البيانات والفهارس والبيانات الأولية عند أول طلب (1 مفعّل، 0 معطّل)
ZUM_AUTO_INIT=1

# مدة خمول الجلسة بالثواني قبل انتهاء الصلاحية (1800 ثانية = 30 دقيقة)
ZUM_SESSION_IDLE=1800

# أقصى مدة لجلسة العمل بالثواني (28800 ثانية = 8 ساعات)
ZUM_SESSION_MAX=28800

# إعدادات التطوير المحلي فقط (اختيارية):
# ZUM_HOST=127.0.0.1
# ZUM_PORT=8000
